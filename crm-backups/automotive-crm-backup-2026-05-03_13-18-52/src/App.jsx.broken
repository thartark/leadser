// ==================== NEW COMPONENTS ====================

const ProgressBar = ({ progress, color = "bg-indigo-600" }) => (
  <div className="w-full bg-slate-200 rounded-full h-2">
    <div className={`${color} h-2 rounded-full transition-all duration-500`} style={{ width: `${progress}%` }}></div>
  </div>
);

const TeamChat = ({ onToast }) => {
  const [messages, setMessages] = useState(chatMessages);
  const [newMessage, setNewMessage] = useState("");
  
  const sendMessage = () => {
    if (!newMessage.trim()) return;
    const msg = { id: messages.length + 1, sender: "You", message: newMessage, time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }), avatar: "You", unread: false };
    setMessages([...messages, msg]);
    setNewMessage("");
    onToast("Message sent!", "success");
  };
  
  return (
    <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border h-[400px] flex flex-col">
      <div className="p-3 border-b bg-slate-50 dark:bg-slate-700/50 rounded-t-xl">
        <h3 className="font-semibold flex items-center gap-2"><MessageCircle size={16} /> Team Chat</h3>
      </div>
      <div className="flex-1 overflow-y-auto p-3 space-y-2">
        {messages.map(msg => (
          <div key={msg.id} className={`flex items-start gap-2 p-2 rounded-lg ${msg.sender === "You" ? 'bg-indigo-50 dark:bg-indigo-900/20' : 'hover:bg-slate-50'}`}>
            <div className="w-8 h-8 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center text-white text-xs font-bold">{msg.avatar === "You" ? "You" : msg.avatar}</div>
            <div className="flex-1"><p className="text-sm font-medium">{msg.sender}</p><p className="text-xs text-slate-600 dark:text-slate-300">{msg.message}</p><p className="text-xs text-slate-400 mt-1">{msg.time}</p></div>
            {msg.unread && <div className="w-2 h-2 bg-indigo-500 rounded-full"></div>}
          </div>
        ))}
      </div>
      <div className="p-3 border-t flex gap-2">
        <input type="text" value={newMessage} onChange={(e) => setNewMessage(e.target.value)} onKeyPress={(e) => e.key === 'Enter' && sendMessage()} placeholder="Type a message..." className="flex-1 px-3 py-2 text-sm border rounded-lg bg-slate-50 dark:bg-slate-900" />
        <button onClick={sendMessage} className="p-2 bg-indigo-500 text-white rounded-lg hover:bg-indigo-600"><Send size={16} /></button>
      </div>
    </div>
  );
};

const DocumentLibrary = ({ onToast }) => {
  const [docs, setDocs] = useState(documents);
  
  return (
    <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border">
      <div className="p-3 border-b bg-slate-50 dark:bg-slate-700/50 rounded-t-xl flex justify-between items-center">
        <h3 className="font-semibold flex items-center gap-2"><FileText size={16} /> Document Library</h3>
        <button onClick={() => onToast("Upload document", "info")} className="text-indigo-600 text-sm">+ Upload</button>
      </div>
      <div className="divide-y">
        {docs.map(doc => (
          <div key={doc.id} className="p-3 flex items-center justify-between hover:bg-slate-50 transition-colors">
            <div className="flex items-center gap-3">
              <div className="p-2 bg-indigo-100 rounded-lg"><FileText size={16} className="text-indigo-600" /></div>
              <div><p className="text-sm font-medium">{doc.name}</p><p className="text-xs text-slate-500">{doc.size} • {doc.date} • {doc.uploadedBy}</p></div>
            </div>
            <button onClick={() => onToast(`Downloading ${doc.name}`, "success")} className="p-1 hover:bg-slate-100 rounded"><Download size={14} /></button>
          </div>
        ))}
      </div>
    </div>
  );
};

const CalendarWidget = ({ onToast }) => {
  const [events, setEvents] = useState(calendarEvents);
  
  return (
    <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border">
      <div className="p-3 border-b bg-slate-50 dark:bg-slate-700/50 rounded-t-xl flex justify-between items-center">
        <h3 className="font-semibold flex items-center gap-2"><Calendar size={16} /> Upcoming Events</h3>
        <button onClick={() => onToast("Add event", "info")} className="text-indigo-600 text-sm">+ Add</button>
      </div>
      <div className="divide-y">
        {events.map(event => (
          <div key={event.id} className="p-3 flex items-center gap-3 hover:bg-slate-50 transition-colors">
            <div className={`p-2 rounded-lg ${event.type === 'meeting' ? 'bg-indigo-100' : event.type === 'appointment' ? 'bg-emerald-100' : 'bg-amber-100'}`}>
              {event.type === 'meeting' && <Users size={14} className="text-indigo-600" />}
              {event.type === 'appointment' && <Calendar size={14} className="text-emerald-600" />}
              {event.type === 'training' && <Award size={14} className="text-amber-600" />}
              {event.type === 'task' && <CheckCircle size={14} className="text-purple-600" />}
            </div>
            <div className="flex-1"><p className="text-sm font-medium">{event.title}</p><p className="text-xs text-slate-500">{event.date} at {event.time}</p></div>
            <button onClick={() => onToast(`Viewing ${event.title}`, "info")} className="text-indigo-600 text-xs">Details</button>
          </div>
        ))}
      </div>
    </div>
  );
};

const KPITracker = ({ onToast }) => {
  return (
    <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border p-4">
      <h3 className="font-semibold mb-3 flex items-center gap-2"><Target size={16} /> KPI Targets</h3>
      <div className="space-y-3">
        {kpiTargets.map(kpi => (
          <div key={kpi.metric}>
            <div className="flex justify-between text-sm mb-1"><span>{kpi.metric}</span><span>{kpi.current} / {kpi.target}</span></div>
            <ProgressBar progress={kpi.progress} />
            <p className="text-xs text-slate-500 mt-1">{kpi.progress}% to goal</p>
          </div>
        ))}
      </div>
    </div>
  );
};

const SocialFeed = ({ onToast }) => {
  const [feeds, setFeeds] = useState(socialFeeds);
  
  return (
    <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border">
      <div className="p-3 border-b bg-slate-50 dark:bg-slate-700/50 rounded-t-xl">
        <h3 className="font-semibold flex items-center gap-2"><Activity size={16} /> Team Activity Feed</h3>
      </div>
      <div className="divide-y">
        {feeds.map(feed => (
          <div key={feed.id} className="p-3 hover:bg-slate-50 transition-colors">
            <div className="flex items-start gap-3">
              <div className="w-8 h-8 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 flex items-center justify-center text-white text-xs font-bold">{feed.user.charAt(0)}</div>
              <div className="flex-1"><p className="text-sm"><span className="font-medium">{feed.user}</span> {feed.action} {feed.target}{feed.amount && <span className="text-emerald-600"> for {feed.amount}</span>}</p><p className="text-xs text-slate-400 mt-1">{feed.time}</p></div>
            </div>
            <div className="flex gap-3 mt-2 pl-11">
              <button className="text-xs text-slate-500 flex items-center gap-1"><Heart size={12} /> {feed.likes}</button>
              <button className="text-xs text-slate-500 flex items-center gap-1"><MessageCircle size={12} /> {feed.comments}</button>
            </div>
          </div>
        ))}
      </div>
    </div>
