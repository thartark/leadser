};

const KnowledgeBase = ({ onToast }) => {
  const [articles, setArticles] = useState(knowledgeBase);
  
  return (
    <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border">
      <div className="p-3 border-b bg-slate-50 dark:bg-slate-700/50 rounded-t-xl flex justify-between items-center">
        <h3 className="font-semibold flex items-center gap-2"><Bookmark size={16} /> Knowledge Base</h3>
        <button onClick={() => onToast("Search knowledge base", "info")} className="text-indigo-600 text-sm">Search</button>
      </div>
      <div className="divide-y">
        {articles.map(article => (
          <div key={article.id} className="p-3 hover:bg-slate-50 transition-colors cursor-pointer" onClick={() => onToast(`Opening: ${article.title}`, "info")}>
            <p className="text-sm font-medium">{article.title}</p>
            <div className="flex justify-between items-center mt-1"><span className="text-xs text-slate-500">{article.category}</span><div className="flex gap-2 text-xs text-slate-400"><span>👁️ {article.views}</span><span>👍 {article.helpful}</span></div></div>
          </div>
        ))}
      </div>
    </div>
  );
};

const WeatherWidget = () => {
  const [weather, setWeather] = useState({ temp: 72, condition: "Sunny", icon: "☀️" });
  return (
    <div className="bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl p-4 text-white">
      <div className="flex justify-between items-center">
        <div><p className="text-sm opacity-90">Today's Weather</p><p className="text-3xl font-bold">{weather.temp}°F</p><p className="text-sm">{weather.condition}</p></div>
        <div className="text-5xl">{weather.icon}</div>
      </div>
      <p className="text-xs opacity-80 mt-2">Great day for test drives!</p>
    </div>
  );
};

const QuickStats = () => {
  const stats = [
    { label: "Active Users", value: "12", icon: Users, change: "+2" },
    { label: "Page Views", value: "1,247", icon: Eye, change: "+18%" },
    { label: "Avg Session", value: "4m 32s", icon: Clock, change: "+12%" },
  ];
  return (
    <div className="grid grid-cols-3 gap-3">
      {stats.map(stat => (
        <div key={stat.label} className="bg-white dark:bg-slate-800 rounded-xl p-3 text-center border">
          <stat.icon size={16} className="mx-auto text-indigo-500 mb-1" />
          <p className="text-lg font-bold">{stat.value}</p>
          <p className="text-xs text-slate-500">{stat.label}</p>
          <p className="text-xs text-emerald-600">{stat.change}</p>
        </div>
      ))}
    </div>
  );
};

