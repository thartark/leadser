};

// ==================== NEW PAGE: REPORTS CENTER ====================
const ReportsCenterPage = ({ onToast }) => {
  const [reportType, setReportType] = useState("sales");
  const reports = {
    sales: { title: "Sales Report", data: salespeople, columns: ["Name", "Units", "Gross", "Close Rate"] },
    inventory: { title: "Inventory Report", data: inventoryData, columns: ["Vehicle", "Price", "Days on Lot", "Status"] },
    service: { title: "Service Report", data: serviceAppointments, columns: ["Customer", "Service", "Status", "Advisor"] },
  };
  
  return (
    <div className="space-y-5">
      <div className="flex justify-between items-center"><h2 className="text-xl font-semibold">Reports Center</h2><button onClick={() => onToast("Report exported", "success")} className="bg-indigo-600 text-white px-4 py-2 rounded-lg text-sm flex items-center gap-2"><Download size={16} /> Export All</button></div>
      <div className="flex gap-2 border-b pb-2">{["sales", "inventory", "service"].map(type => (<button key={type} onClick={() => setReportType(type)} className={`px-4 py-2 text-sm rounded-lg ${reportType === type ? 'bg-indigo-100 text-indigo-700' : 'hover:bg-slate-100'}`}>{type.charAt(0).toUpperCase() + type.slice(1)}</button>))}</div>
      <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border overflow-hidden">
        <div className="p-4 bg-slate-50 border-b"><h3 className="font-semibold">{reports[reportType].title}</h3></div>
        <div className="overflow-x-auto">
          <table className="w-full">
            <thead className="bg-slate-50"><tr>{reports[reportType].columns.map(col => (<th key={col} className="px-4 py-3 text-left text-xs font-medium text-slate-500">{col}</th>))}</tr></thead>
            <tbody className="divide-y">
              {reportType === "sales" && reports.sales.data.map(rep => (<tr key={rep.id}><td className="px-4 py-3">{rep.name}</td><td className="px-4 py-3">{rep.units}</td><td className="px-4 py-3">${(rep.gross/1000).toFixed(0)}K</td><td className="px-4 py-3">{rep.closeRate}%</td></tr>))}
              {reportType === "inventory" && reports.inventory.data.map(vehicle => (<tr key={vehicle.id}><td className="px-4 py-3">{vehicle.make} {vehicle.model}</td><td className="px-4 py-3">${vehicle.price.toLocaleString()}</td><td className="px-4 py-3">{vehicle.daysOnLot}</td><td className="px-4 py-3"><StatusBadge status={vehicle.status} /></td></tr>))}
              {reportType === "service" && reports.service.data.map(apt => (<tr key={apt.id}><td className="px-4 py-3">{apt.customer}</td><td className="px-4 py-3">{apt.service}</td><td className="px-4 py-3"><StatusBadge status={apt.status} /></td><td className="px-4 py-3">{apt.advisor}</td></tr>))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  );
};

// ==================== NEW PAGE: TEAM PERFORMANCE ====================
const TeamPerformancePage = ({ onToast }) => {
  const [selectedRep, setSelectedRep] = useState("all");
  const filteredReps = selectedRep === "all" ? salespeople : salespeople.filter(r => r.name === selectedRep);
  const teamAvg = {
    units: filteredReps.reduce((sum, r) => sum + r.units, 0) / filteredReps.length,
    gross: filteredReps.reduce((sum, r) => sum + r.gross, 0) / filteredReps.length,
    closeRate: filteredReps.reduce((sum, r) => sum + r.closeRate, 0) / filteredReps.length,
  };
  
  return (
    <div className="space-y-5">
      <div className="flex justify-between items-center"><h2 className="text-xl font-semibold">Team Performance</h2><select value={selectedRep} onChange={(e) => setSelectedRep(e.target.value)} className="px-3 py-2 border rounded-lg text-sm"><option value="all">All Reps</option>{salespeople.map(r => <option key={r.id} value={r.name}>{r.name}</option>)}</select></div>
      <div className="grid grid-cols-1 md:grid-cols-3 gap-4"><div className="bg-white dark:bg-slate-800 rounded-xl p-4 text-center border"><p className="text-2xl font-bold text-indigo-600">{teamAvg.units.toFixed(1)}</p><p className="text-sm text-slate-500">Avg Units/Rep</p></div><div className="bg-white dark:bg-slate-800 rounded-xl p-4 text-center border"><p className="text-2xl font-bold text-emerald-600">${(teamAvg.gross/1000).toFixed(0)}K</p><p className="text-sm text-slate-500">Avg Gross/Rep</p></div><div className="bg-white dark:bg-slate-800 rounded-xl p-4 text-center border"><p className="text-2xl font-bold text-amber-600">{teamAvg.closeRate.toFixed(1)}%</p><p className="text-sm text-slate-500">Avg Close Rate</p></div></div>
      <div className="bg-white dark:bg-slate-800 rounded-xl shadow-sm border overflow-hidden">
        <div className="overflow-x-auto"><table className="w-full"><thead className="bg-slate-50"><tr className="text-left text-xs font-medium text-slate-500 uppercase"><th className="px-4 py-3">Rank</th><th className="px-4 py-3">Rep</th><th className="px-4 py-3">Leads</th><th className="px-4 py-3">Appts</th><th className="px-4 py-3">Units</th><th className="px-4 py-3">Gross</th><th className="px-4 py-3">Close %</th><th className="px-4 py-3">Target</th><th className="px-4 py-3">Achievement</th></tr></thead><tbody className="divide-y">{filteredReps.map((rep, idx) => (<tr key={rep.id} className="hover:bg-slate-50"><td className="px-4 py-3"><div className="w-6 h-6 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-xs">{idx+1}</div></td><td className="px-4 py-3 font-medium">{rep.name}</td><td className="px-4 py-3">{rep.leads}</td><td className="px-4 py-3">{rep.appts}</td><td className="px-4 py-3 font-bold">{rep.units}</td><td className="px-4 py-3 text-emerald-600">${(rep.gross/1000).toFixed(0)}K</td><td className="px-4 py-3">{rep.closeRate}%</td><td className="px-4 py-3">{rep.target}</td><td className="px-4 py-3"><div className="flex items-center gap-2"><div className="w-16 bg-slate-200 rounded-full h-2"><div className={`h-2 rounded-full ${rep.achievement >= 90 ? 'bg-emerald-500' : 'bg-amber-500'}`} style={{ width: `${rep.achievement}%` }}></div></div><span className="text-xs">{rep.achievement}%</span></div></td></tr>))}</tbody>}</table></div>
      </div>
    </div>
  );
};

// ==================== NEW PAGE: CUSTOMER INSIGHTS ====================
const CustomerInsightsPage = ({ onToast }) => {
  const [selectedCustomer, setSelectedCustomer] = useState(null);
  const topCustomers = leadsData.slice(0, 5);
  
  return (
    <div className="space-y-5">
      <h2 className="text-xl font-semibold">Customer Insights</h2>
      <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div className="bg-white dark:bg-slate-800 rounded-xl p-5 border"><h3 className="font-semibold mb-3">Top Customers by Value</h3><div className="space-y-3">{topCustomers.map(customer => (<div key={customer.id} className="flex items-center justify-between p-3 bg-slate-50 rounded-lg cursor-pointer hover:bg-slate-100" onClick={() => setSelectedCustomer(customer)}><div><p className="font-medium">{customer.name}</p><p className="text-xs text-slate-500">{customer.vehicle}</p></div><div className="text-right"><p className="font-bold text-indigo-600">${customer.budget.toLocaleString()}</p><p className="text-xs text-slate-500">{customer.source}</p></div></div>))}</div></div>
        <div className="bg-white dark:bg-slate-800 rounded-xl p-5 border"><h3 className="font-semibold mb-3">Customer Satisfaction</h3><div className="text-center py-8"><div className="text-5xl font-bold text-indigo-600">4.8</div><div className="flex justify-center gap-1 my-3">{[...Array(5)].map((_, i) => (<Star key={i} size={24} className={i < 4.8 ? "text-yellow-400 fill-yellow-400" : "text-slate-300"} />))}</div><p className="text-sm text-slate-500">Based on 247 reviews</p><button className="mt-4 text-indigo-600 text-sm">View all reviews →</button></div></div>
      </div>
      {selectedCustomer && (<div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50" onClick={() => setSelectedCustomer(null)}><div className="bg-white dark:bg-slate-800 rounded-xl max-w-md w-full mx-4 p-6" onClick={(e) => e.stopPropagation()}><div className="flex justify-between items-center mb-4"><h3 className="text-lg font-semibold">{selectedCustomer.name}</h3><button onClick={() => setSelectedCustomer(null)} className="p-1 hover:bg-slate-100 rounded"><X size={20} /></button></div><div className="space-y-3"><p><span className="text-slate-500">Vehicle:</span> {selectedCustomer.vehicle}</p><p><span className="text-slate-500">Budget:</span> ${selectedCustomer.budget.toLocaleString()}</p><p><span className="text-slate-500">Source:</span> {selectedCustomer.source}</p><p><span className="text-slate-500">Status:</span> <StatusBadge status={selectedCustomer.status} /></p><p><span className="text-slate-500">Rep:</span> {selectedCustomer.rep}</p></div><div className="flex gap-2 mt-4"><button className="flex-1 bg-indigo-600 text-white py-2 rounded-lg">Contact</button><button className="flex-1 bg-slate-100 py-2 rounded-lg">View Details</button></div></div></div>)}
    </div>
  );
};

// ==================== UPDATE THE APP WITH NEW PAGES ====================
// Add these new pages to navigation and renderPage function
