  { id: 1, user: "Sarah Chen", action: "closed a deal", target: "Ford F-150", amount: "$58,995", time: "1 hour ago", likes: 12, comments: 3 },
  { id: 2, user: "Mike Rodriguez", action: "set appointment", target: "Tesla Model Y", time: "2 hours ago", likes: 8, comments: 1 },
