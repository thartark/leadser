const StatusBadge = ({ status }) => {
  const config = {
    Hot: "bg-rose-100 text-rose-700", Warm: "bg-amber-100 text-amber-700", Cold: "bg-slate-100 text-slate-700",
    Available: "bg-emerald-100 text-emerald-700", Pending: "bg-indigo-100 text-indigo-700",
    "In Progress": "bg-indigo-100 text-indigo-700", Waiting: "bg-amber-100 text-amber-700",
    Scheduled: "bg-slate-100 text-slate-700", High: "bg-rose-100 text-rose-700",
    Medium: "bg-amber-100 text-amber-700", Low: "bg-slate-100 text-slate-700", Active: "bg-emerald-100 text-emerald-700"
  };
  return <span className={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${config[status] || "bg-slate-100"}`}>{status}</span>;
};

